<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="dotpesa_new_dec_2022"
    >

    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.INSTANT_APP_FOREGROUND_SERVICE"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.REQUEST_COMPANION_START_FOREGROUND_SERVICES_FROM_BACKGROUND"/>
    <uses-permission android:name="android.permission.START_FOREGROUND_SERVICES_FROM_BACKGROUND"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.PROCESS_OUTGOING_CALLS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.STORAGE" />
    <uses-permission android:name="android.permission.READ_PRIVILEGED_PHONE_STATE"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />


    <application
        android:networkSecurityConfig="@xml/network_security_config"
        android:name="com.example.dotpesa_new_dec_2022.core.App"
        android:allowBackup="true"
        android:launchMode="singleTop"
        android:supportsRtl="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/my_app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.DotPesaNEW2"
       >
        <receiver
            android:name="com.example.dotpesa_new_dec_2022.core.startupOnBootUp"
            android:permission="android.permission.RECEIVE_BOOT_COMPLETED"
            android:label="startupOnBootUp"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.QUICKBOOT_POWERON"/>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED"/>
                <action android:name="android.intent.action.REBOOT"/>
                <action android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </receiver>
        <activity
            android:name="com.example.dotpesa_new_dec_2022.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>


        <service
            android:name="com.example.dotpesa_new_dec_2022.core.SmsService"
            android:label="SMS LISTENER SERVICE"
            android:foregroundServiceType="dataSync"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.REBOOT" />
            </intent-filter>
            <intent-filter>
                <action android:name="dotpesa_new_dec_2022.core.CallSmsService" />
            </intent-filter>
        </service>

        <receiver android:name="com.example.dotpesa_new_dec_2022.utilities.startupOnBootUpReceiver" android:label="startupOnBootUpReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.REBOOT" />
            </intent-filter>
        </receiver>

        <activity android:name="com.example.dotpesa_new_dec_2022.utilities.ProcessReceivedSMSMessage" android:label="processReceivedSMSMessage"
            android:exported="false"/>

        <activity
            android:name="com.example.dotpesa_new_dec_2022.Appfunctionality"
            android:exported="false" />
        <activity
            android:name="com.example.dotpesa_new_dec_2022.Login"
            android:exported="true" />


        <activity android:name="com.example.dotpesa_new_dec_2022.call_sms_db_modules.PermissionsActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
            </intent-filter>
        </activity>


        <receiver
            android:name="com.example.dotpesa_new_dec_2022.call_sms_db_modules.sms.SmsReceiver"
            android:permission="android.permission.BROADCAST_SMS"
            android:exported="true">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>


        <receiver android:name="com.example.dotpesa_new_dec_2022.call_sms_db_modules.reciever.RestartReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="InfiniteService" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>