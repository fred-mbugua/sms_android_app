<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.DotPesaNEW2" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/misooGreen</item>
        <item name="colorPrimaryVariant">@color/misooGreenDark</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/misooGreen</item>
        <item name="colorSecondaryVariant">@color/misooGreenDark</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- Background & Surface Colors -->
        <item name="android:windowBackground">@color/bg_main</item>
        <item name="colorSurface">@color/card_bg</item>
        <item name="colorOnSurface">@color/text_primary</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/bg_main</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>

        <item name="android:windowContentTransitions">true</item>
    </style>
</resources>