<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/divider_color"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SMS Message Filtering"
                    android:textColor="@color/misooGreen"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Choose which incoming SMS messages DotPesa should capture, process, and display."
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Filter Mode Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/divider_color"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Filtering Mode"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rgSmsFilterMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <RadioButton
                        android:id="@+id/rbAllowAll"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Allow Any Message (No Filter)"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="32dp"
                        android:layout_marginBottom="12dp"
                        android:text="Captures and displays all incoming SMS messages that arrive on this device."
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <RadioButton
                        android:id="@+id/rbFilterSelected"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Filter Selected Financial Providers Only"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="32dp"
                        android:text="Only process and display messages from checked Mobile Money and Bank senders below. All other personal or promotional SMS will be ignored."
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                </RadioGroup>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Selected Providers Container Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardProvidersContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/divider_color"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Allowed Mobile Money &amp; Bank Providers"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Check providers you wish to capture in DotPesa:"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:background="@color/divider_color" />

                <CheckBox
                    android:id="@+id/cbFilterMpesa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="M-PESA / Safaricom (MPESA, Ksh confirmed)"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <CheckBox
                    android:id="@+id/cbFilterAirtel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Airtel Money (AIRTELMONEY, AMONEY)"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/cbFilterTkash"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="T-Kash / Telkom (TKASH)"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/cbFilterEquity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Equity Bank / Eazzy Pay (EQUITY, EAZZY)"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/cbFilterKcb"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="KCB Bank (KCB, KCBBANK)"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/cbFilterCoop"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Co-operative Bank (COOPBANK, COOP)"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/cbFilterNcba"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="NCBA / Loop (NCBA, LOOP)"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/cbFilterBanks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Other East African Banks (Absa, Stanbic, Family Bank, DTB, I&amp;M)"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Save Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveGeneralSettings"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Save Filtering Settings"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@color/misooGreen"
            app:cornerRadius="12dp" />

    </LinearLayout>

</ScrollView>