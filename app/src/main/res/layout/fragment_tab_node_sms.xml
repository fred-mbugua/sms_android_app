<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main">

    <!-- Header Search & Summary Banner -->
    <LinearLayout
        android:id="@+id/node_sms_header_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Search Bar -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:strokeColor="@color/divider_color"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/help_center_24"
                    app:tint="@color/text_secondary"
                    android:contentDescription="Search SMS" />

                <EditText
                    android:id="@+id/node_sms_search_edit_text"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Search Node.js SMS by Sender, Text, Code..."
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_secondary"
                    android:textSize="14sp" />

                <ImageView
                    android:id="@+id/node_sms_search_clear_btn"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/logout_24"
                    android:visibility="gone"
                    app:tint="@color/text_secondary"
                    android:contentDescription="Clear search" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Date Filter Toolbar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/node_sms_btn_from_date"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:padding="0dp"
                android:text="From: Select"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                app:cornerRadius="8dp"
                app:strokeColor="@color/divider_color" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/node_sms_btn_to_date"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:padding="0dp"
                android:text="To: Select"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                app:cornerRadius="8dp"
                app:strokeColor="@color/divider_color" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/node_sms_btn_clear_date"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:padding="0dp"
                android:text="Clear Dates"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                app:cornerRadius="8dp"
                app:strokeColor="@color/divider_color" />

        </LinearLayout>

        <!-- Summary Banner Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/node_sms_summary_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="@color/card_bg"
            app:cardCornerRadius="12dp"
            app:cardElevation="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="12dp">

                <TextView
                    android:id="@+id/node_sms_total_count_txt"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0 SMS Messages"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/node_sms_total_extracted_amount_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total: KES 0.00"
                    android:textColor="@color/appPrimaryGreen"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Action Toolbar: Export Excel, Export PDF -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/node_sms_btn_export_excel"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:padding="0dp"
                android:text="Export Excel"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                app:cornerRadius="8dp"
                app:strokeColor="@color/divider_color" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/node_sms_btn_export_pdf"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:padding="0dp"
                android:text="Export PDF"
                android:textColor="@color/appErrorRed"
                android:textSize="12sp"
                app:cornerRadius="8dp"
                app:strokeColor="@color/appErrorRed" />

        </LinearLayout>

    </LinearLayout>

    <!-- RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/nodeSmsRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/node_sms_header_container"
        android:clipToPadding="false"
        android:scrollbars="vertical|horizontal"
        android:fadeScrollbars="false"
        android:scrollbarSize="4dp"
        android:paddingBottom="80dp" />

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/nodeSmsEmptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:src="@drawable/ic_empty_inbox"
            android:contentDescription="No SMS" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="No Node.js SMS Messages Found"
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium" />

    </LinearLayout>

    <!-- FAB Refresh -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/node_sms_fab_refresh"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_margin="20dp"
        android:src="@drawable/fab_refresh_24"
        app:backgroundTint="@color/appPrimaryGreen"
        app:tint="@color/white"
        app:elevation="6dp" />

</RelativeLayout>